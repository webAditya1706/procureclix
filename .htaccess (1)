# Enable Rewrite Engine
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www (remove www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Clean URLs for root-level pages
RewriteRule ^about/?$ about-us.html [L]
RewriteRule ^services/?$ services.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^comingsoon/$ / [R=301,NC,L]

# Redirect both /comingsoon/index.html and /comingSoon/index.html (case-insensitive)
RewriteRule ^comingsoon/index\.html$ https://procureclix.com/contact-us.html [R=301,NC,L]



