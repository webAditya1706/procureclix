# Enable Rewrite Engine
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www (remove www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Clean URLs for root-level pages
RewriteRule ^about/?$ about.html [L]
RewriteRule ^services/?$ services.html [L]
RewriteRule ^contact/?$ contact.html [L]

# Services URLs
RewriteRule ^services/procurement-spend-analysis-services/?$ services/procurement-spend-analysis-services.html [L]
RewriteRule ^services/rfp-managed-services/?$ services/rfp-managed-services.html [L]
RewriteRule ^services/managed-reverse-auction-software-services/?$ services/managed-reverse-auction-software-services.html [L]

# Industries URLs
RewriteRule ^industries/procurement-software-for-transport-logistics-industry/?$ industries/procurement-software-for-transport-logistics-industry.html [L]
RewriteRule ^industries/procurement-software-for-healthcare-industry/?$ industries/procurement-software-for-healthcare-industry.html [L]
RewriteRule ^industries/procurement-software-for-automotive-companies/?$ industries/procurement-software-for-automotive-companies.html [L]
RewriteRule ^industries/procurement-software-for-manufacturing-industry/?$ industries/procurement-software-for-manufacturing-industry.html [L]
RewriteRule ^industries/procurement-software-for-food-beverage-industry/?$ industries/procurement-software-for-food-beverage-industry.html [L]
RewriteRule ^industries/procurement-software-for-biotech-pharma/?$ industries/procurement-software-for-biotech-pharma.html [L]
RewriteRule ^industries/procurement-software-for-energy-brokers-suppliers/?$ industries/procurement-software-for-energy-brokers-suppliers.html [L]
RewriteRule ^industries/construction-&-real-estate-procurement-software/?$ industries/construction-&-real-estate-procurement-software.html [L]

#Solutions URLs
RewriteRule ^solutions/best-rfp-software-streamline-souring-&-supplier-selection-procureclix/?$ solutions/best-rfp-software-streamline-souring-&-supplier-selection-procureclix.html [L]
RewriteRule ^solutions/procurement-spend-analysis-software/?$ solutions/procurement-spend-analysis-software.html [L]
RewriteRule ^solutions/best-reverse-auction-software/?$ solutions/best-reverse-auction-software.html [L]
RewriteRule ^solutions/custom-auction-procurement-software/?$ solutions/custom-auction-procurement-software.html [L]
RewriteRule ^solutions/purchase-requisition-software/?$ solutions/purchase-requisition-software.html [L]
